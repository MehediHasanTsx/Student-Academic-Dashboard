# Neon PostgreSQL connection string
# Get one free at https://neon.tech
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Resend API Key for Email OTP Password Recovery (Optional)
# Get your key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=DCC CSE <onboarding@resend.dev>

# Gmail SMTP Configuration (Recommended: free, sends to any student without domain verification)
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=DCC CSE <your_email@gmail.com>


